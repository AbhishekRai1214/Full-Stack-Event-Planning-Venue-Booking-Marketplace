# ============================================================
# VenueAura Backend – Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to Git.
# ============================================================

# Application
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ============================================================
# Database
# ============================================================
# For local development without transactions:
MONGODB_URI=mongodb://localhost:27017/venueaura

# For transactions support (requires replica set):
# MONGODB_URI=mongodb://localhost:27017/venueaura?replicaSet=rs0

# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/venueaura

# ============================================================
# JWT Authentication
# Generate secrets with: openssl rand -base64 64
# ============================================================
ACCESS_TOKEN_SECRET=change_this_to_a_random_64_char_string_minimum
REFRESH_TOKEN_SECRET=change_this_to_a_different_random_64_char_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ============================================================
# CORS – Frontend URLs (comma-separated)
# ============================================================
ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# Cloudinary – Image Upload (Phase 13)
# Get credentials from: https://cloudinary.com/console
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# Razorpay – Payments (Phase 13)
# Use TEST keys in development. NEVER commit live keys.
# Get test keys from: https://dashboard.razorpay.com/app/keys
# ============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ============================================================
# Email – Nodemailer (Phase 11)
# Gmail: Enable "App Passwords" in Google Account security.
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VenueAura <no-reply@venueaura.com>

# ============================================================
# Logging
# Levels: trace | debug | info | warn | error | fatal
# ============================================================
LOG_LEVEL=info

