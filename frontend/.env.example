# ============================================================
# VenueAura Frontend – Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file.
# All variables must be prefixed with VITE_ to be accessible in React.
# ============================================================

# Backend API URL
VITE_API_URL=http://localhost:5000/api/v1

# Razorpay – Public Key (safe to expose, used for checkout initialization)
# Get from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=

# Google Maps (optional, for venue location display)
VITE_GOOGLE_MAPS_KEY=

