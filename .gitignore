# VenueAura – Root .gitignore

# ===========================
# Node Modules
# ===========================
node_modules/
**/node_modules/

# ===========================
# Environment Variables (NEVER commit these)
# ===========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
!**/.env.example

# ===========================
# Build Outputs
# ===========================
dist/
build/
**/dist/
**/build/

# ===========================
# Frontend (Vite)
# ===========================
frontend/.vite/
frontend/dist/

# ===========================
# Backend
# ===========================
backend/logs/
backend/uploads/

# ===========================
# Testing
# ===========================
coverage/
**/coverage/
.nyc_output/
*.lcov

# ===========================
# Logs
# ===========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===========================
# OS Files
# ===========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===========================
# Editor & IDE
# ===========================
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# Keep shared VS Code extensions list
!.vscode/extensions.json

# ===========================
# Temporary Files
# ===========================
*.tmp
*.temp
.cache/
*.cache

# ===========================
# Package Manager Locks (keep these)
# ===========================
# package-lock.json  <- keep
# yarn.lock          <- keep

# ===========================
# Docker
# ===========================
# docker-compose.override.yml

# ===========================
# Miscellaneous
# ===========================
*.pem
*.key
*.crt
*.p12
.turbo/
.nx/
